tpm2 autostart
#setenv board_args coherent_pool=1M 8250.nr_uarts=1 snd_bcm2835.enable_hdmi=0
setenv prefix /boot
setenv overlay @@U_BOOT_OVERLAYS@@
setenv loading_mmc @@BOOT_MEDIA@@ ${devnum}:${distro_bootpart}
load ${loading_mmc} ${kernel_addr_r} ${prefix}/@@KERNEL_IMAGETYPE@@
fdt move ${fdt_addr} ${fdt_addr_r}
fdt addr ${fdt_addr_r}
fdt resize
if test "${overlay}" != "" && fdt list /__symbols__ rmem; then
    fdt resize 8192
    setexpr fdtovaddr ${fdt_addr_r} + C0000
    setenv break 0
    for ov in ${overlay}; do
      if test "${break}" = "0" ; then
        echo "Load and apply overlay ${ov}"
        if load ${loading_mmc} ${fdtovaddr} ${prefix}/overlays/${ov}.dtbo ; then
            if fdt apply ${fdtovaddr}; then
                echo "OK"
            else
                setenv break 1
            fi
        fi
      fi
    done
    if test "${break}" = "1" ; then
        setenv fdt_addr_r ${fdt_addr}
        fdt addr ${fdt_addr_r}
        fdt resize
    fi
fi
if fdt get value vcc /regulator-vdd phandle; then
  fdt set /soc/i2c@7e804000/24c01@57 vcc-supply <${vcc}>
fi
fdt get value bootargs /chosen bootargs
setexpr bootargs gsub "console=[^ ]* " ""
setexpr bootargs gsub "root=[^ ]* " ""
setexpr bootargs gsub "rootfstype=[^ ]* " ""
setexpr bootargs gsub "kgdboc=[^ ]* " ""
setenv bootargs root=/dev/mmcblk${devnum}p${distro_bootpart} rw systemd.watchdog_device=/dev/watchdog1 net.ifnames=0 audit=0 ${bootargs}
if test "${extra}" = "" ; then
   setenv extra panic=10 quiet
else
   setenv extra console=${console},${baudrate} ${extra}
fi
setenv bootargs console=tty1 ${bootargs} ${extra}
bootcount reset
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr_r}
