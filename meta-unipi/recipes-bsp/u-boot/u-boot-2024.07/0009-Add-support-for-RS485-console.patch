From: Miroslav Ondra <ondra@faster.cz>
Date: Sat, 14 Sep 2024 13:03:15 +0200
Subject: [PATCH 09/14] Add support for RS485 console

---
 board/raspberrypi/rpi/rpi.c        | 73 +++++++++++++++++++++++++++---
 drivers/serial/serial_bcm283x_mu.c |  9 +++-
 drivers/serial/serial_pl01x.c      | 22 +++++++--
 3 files changed, 92 insertions(+), 12 deletions(-)

diff --git a/board/raspberrypi/rpi/rpi.c b/board/raspberrypi/rpi/rpi.c
index 18c74cb9..c7aca79b 100644
--- a/board/raspberrypi/rpi/rpi.c
+++ b/board/raspberrypi/rpi/rpi.c
@@ -19,6 +19,7 @@
 #include <asm/arch/sdhci.h>
 #include <asm/global_data.h>
 #include <dm/platform_data/serial_bcm283x_mu.h>
+#include <asm/io.h>
 #ifdef CONFIG_ARM64
 #include <asm/armv8/mmu.h>
 #endif
@@ -620,7 +621,67 @@ static int get_unipi_eeprom(void)
 }
 
 #define NEURON_BUTTON 12
-#define EDGE_BUTTON 25
+#define EDGE_BUTTON   25
+#define EDGE_RTS      17
+
+int rs485_enable = 0;
+int tx_active  = 0;
+
+/* compatible with AMBA PL011 driver from serial_pl01x.c */
+#define UART_PL011_CR_RTS               (1 << 11)
+#define UART_PL011_CR_RXE               (1 << 9)
+#define UART_PL01x_FR_TXFE              0x80
+#define UART_PL01x_FR_BUSY              0x08
+void rs485_tx_op(u32 *cr2, u32 *sr2, int op)
+{
+	if (rs485_enable != 1) return;
+	if (op == 0) {
+		if (tx_active) {
+			int i = 0;
+			while (!(readl(sr2) & UART_PL01x_FR_BUSY)) {
+				if (++i == 0x1000000) break;
+			}
+			gpio_set_value(EDGE_RTS, 0);
+			/* Enable RX, set alternatively UART driven RTS (inversed) */
+			writel(readl(cr2) | UART_PL011_CR_RTS | UART_PL011_CR_RXE, cr2);
+			tx_active = 0;
+		}
+	} else if (op == 1) {
+		if (!tx_active) {
+			/* Disable RX, clear alternatively UART driven RTS (inversed) */
+			writel(readl(cr2) & (~(UART_PL011_CR_RXE | UART_PL011_CR_RTS)), cr2);
+			gpio_set_value(EDGE_RTS, 1);
+			tx_active = 1;
+		}
+	} else if (op == 2)
+		udelay(1000);
+}
+
+/* compatible with BCM Mini UART  driver from serial_bcm283x_mu.c */
+#define BCM283X_MU_LSR_TX_IDLE		BIT(6)
+/* This actually means not full, but is named not empty in the docs */
+#define BCM283X_MU_LSR_TX_EMPTY		BIT(5)
+void rs485_bcmtx_op(u32 *cr2, u32 *sr2, int op)
+{
+	if (rs485_enable != 1) return;
+	if (op == 0) {
+		if (tx_active) {
+			int i = 0;
+			while (!(readl(sr2) & BCM283X_MU_LSR_TX_IDLE)) {
+				if (++i == 0x1000000) break;
+			}
+			gpio_set_value(EDGE_RTS, 0);
+			tx_active = 0;
+		}
+	} else if (op == 1) {
+		if (!tx_active) {
+			gpio_set_value(EDGE_RTS, 1);
+			tx_active = 1;
+		}
+	} else if (op == 2)
+		udelay(1000);
+}
+
 
 static int check_button_status(void)
 {
@@ -630,7 +691,6 @@ static int check_button_status(void)
 	if (get_unipi_eeprom() != 0)
 		return 0;
 
-	//gpio_request(RTS_BUTTON, "rts button");
 	if (unipi_eeprom_get_uint_property(unipi_eprom, uniee_descriptor, UNIEE_FIELD_TYPE_BUTTON, &button) < 0) {
 		button = 0;
 	}
@@ -649,6 +709,8 @@ static int check_button_status(void)
 			gpio_request(EDGE_BUTTON, "edge button");
 			gpio_direction_input(EDGE_BUTTON);
 			value = gpio_get_value(EDGE_BUTTON);
+			gpio_request(EDGE_RTS, "edge rts");
+			gpio_direction_output(EDGE_RTS, 0);
 			break;
 		default:
 			/* unknown button */
@@ -668,14 +730,11 @@ int board_late_init(void)
 {
 #ifdef CONFIG_I2C_EEPROM
     if (check_button_status()) {
-        //gpio_direction_output(RTS_BUTTON,1);
+        tx_active = 0;
+        rs485_enable = 1;
         printf("Switch off BUTTON and press a KEY on console to break autoboot!\n");
-        //gpio_direction_output(RTS_BUTTON,0);
-        /* ToDo: switch console uart into rs485 mode */
         env_set("bootdelay", "2");
         env_set("bootcmd", "run boot_altboot;run distro_bootcmd");
-        //tx_active = 0;
-        //rs485_enable = 1;
     }
 #endif
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
diff --git a/drivers/serial/serial_bcm283x_mu.c b/drivers/serial/serial_bcm283x_mu.c
index 7585f790..aa182240 100644
--- a/drivers/serial/serial_bcm283x_mu.c
+++ b/drivers/serial/serial_bcm283x_mu.c
@@ -51,6 +51,8 @@ struct bcm283x_mu_priv {
 	struct bcm283x_mu_regs *regs;
 };
 
+__weak void rs485_bcmtx_op(u32 *cr2, u32 *sr2, int op) {}
+
 static int bcm283x_mu_serial_getc(struct udevice *dev);
 
 static int bcm283x_mu_serial_setbrg(struct udevice *dev, int baudrate)
@@ -81,11 +83,13 @@ static int bcm283x_mu_serial_getc(struct udevice *dev)
 	struct bcm283x_mu_regs *regs = priv->regs;
 	u32 data;
 
+	rs485_bcmtx_op(&regs->mcr, &regs->lsr, 0);
 	/* Wait until there is data in the FIFO */
 	if (!(readl(&regs->lsr) & BCM283X_MU_LSR_RX_READY))
 		return -EAGAIN;
 
 	data = readl(&regs->io);
+	rs485_bcmtx_op(&regs->mcr, &regs->lsr, 2);
 
 	return (int)data;
 }
@@ -95,13 +99,15 @@ static int bcm283x_mu_serial_putc(struct udevice *dev, const char data)
 	struct bcm283x_mu_priv *priv = dev_get_priv(dev);
 	struct bcm283x_mu_regs *regs = priv->regs;
 
+	rs485_bcmtx_op(&regs->mcr, &regs->lsr, 1);
 	/* Wait until there is space in the FIFO */
 	if (!(readl(&regs->lsr) & BCM283X_MU_LSR_TX_EMPTY))
 		return -EAGAIN;
 
 	/* Send the character */
 	writel(data, &regs->io);
-
+	if (data == '\n')
+		rs485_bcmtx_op(&regs->mcr, &regs->lsr, 0);
 	return 0;
 }
 
@@ -114,6 +120,7 @@ static int bcm283x_mu_serial_pending(struct udevice *dev, bool input)
 	lsr = readl(&regs->lsr);
 
 	if (input) {
+		rs485_bcmtx_op(&regs->mcr, &regs->lsr, 0);
 		schedule();
 		return (lsr & BCM283X_MU_LSR_RX_READY) ? 1 : 0;
 	} else {
diff --git a/drivers/serial/serial_pl01x.c b/drivers/serial/serial_pl01x.c
index f04c21e0..9e6e83aa 100644
--- a/drivers/serial/serial_pl01x.c
+++ b/drivers/serial/serial_pl01x.c
@@ -35,6 +35,9 @@ static struct pl01x_regs *base_regs __section(".data");
 
 #endif
 
+__weak void rs485_tx_op(u32 *cr2, u32 *sr2, int op) {}
+
+
 static int pl01x_putc(struct pl01x_regs *regs, char c)
 {
 	/* Wait until there is space in the FIFO */
@@ -314,16 +317,26 @@ int pl01x_serial_probe(struct udevice *dev)
 
 int pl01x_serial_getc(struct udevice *dev)
 {
+	int c;
 	struct pl01x_priv *priv = dev_get_priv(dev);
 
-	return pl01x_getc(priv->regs);
+	rs485_tx_op(&priv->regs->pl011_cr, &priv->regs->fr, 0);
+
+	c = pl01x_getc(priv->regs);
+	rs485_tx_op(&priv->regs->pl011_cr, &priv->regs->fr, 2); // udelay(1000)
+	return c;
 }
 
 int pl01x_serial_putc(struct udevice *dev, const char ch)
 {
 	struct pl01x_priv *priv = dev_get_priv(dev);
+	int ret;
 
-	return pl01x_putc(priv->regs, ch);
+	rs485_tx_op(&priv->regs->pl011_cr, &priv->regs->fr, 1);
+	ret = pl01x_putc(priv->regs, ch);
+	if (ch == '\n')
+		rs485_tx_op(&priv->regs->pl011_cr, &priv->regs->fr, 0);
+	return ret;
 }
 
 int pl01x_serial_pending(struct udevice *dev, bool input)
@@ -331,9 +344,10 @@ int pl01x_serial_pending(struct udevice *dev, bool input)
 	struct pl01x_priv *priv = dev_get_priv(dev);
 	unsigned int fr = readl(&priv->regs->fr);
 
-	if (input)
+	if (input) {
+		rs485_tx_op(&priv->regs->pl011_cr, &priv->regs->fr, 0);
 		return pl01x_tstc(priv->regs);
-	else
+	} else
 		return fr & UART_PL01x_FR_TXFE ? 0 : 1;
 }
 
