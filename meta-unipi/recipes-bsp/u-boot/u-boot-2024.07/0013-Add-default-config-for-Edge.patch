From 54ce38eec56ca9c3bded1f13395413a2d9ca29c5 Mon Sep 17 00:00:00 2001
From: Miroslav Ondra <ondra@faster.cz>
Date: Mon, 16 Sep 2024 11:23:40 +0200
Subject: [PATCH 13/14] Add default config for Edge

---
 boot/Kconfig                  |  2 +-
 configs/unipi_arm64_defconfig | 99 +++++++++++++++++++++++++++++++++++
 2 files changed, 100 insertions(+), 1 deletion(-)
 create mode 100644 configs/unipi_arm64_defconfig

diff --git a/boot/Kconfig b/boot/Kconfig
index a7093426..156b07a7 100644
--- a/boot/Kconfig
+++ b/boot/Kconfig
@@ -732,7 +732,7 @@ config BOOTMETH_TRYBOOT
 	  Before running an action bootcount is reset to disable repeated tryboot.
 
 config BOOTMETH_ALTBOOT
-	bool "Bootdev support for loading boot script from /boot/altboot directory
+	bool "Bootdev support for loading boot script from /boot/altboot directory"
 	default y if BOOTMETH_SCRIPT
 	help
 	  Enable support for changing boot directory to /boot/altboot.
diff --git a/configs/unipi_arm64_defconfig b/configs/unipi_arm64_defconfig
new file mode 100644
index 00000000..e163fd7f
--- /dev/null
+++ b/configs/unipi_arm64_defconfig
@@ -0,0 +1,99 @@
+CONFIG_ARM=y
+CONFIG_ARCH_BCM283X=y
+CONFIG_TEXT_BASE=0x00080000
+CONFIG_TARGET_RPI_ARM64=y
+CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
+CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x7fffe30
+CONFIG_ENV_SIZE=0x4000
+CONFIG_DEFAULT_DEVICE_TREE="bcm2711-rpi-4-b"
+CONFIG_OF_LIBFDT_OVERLAY=y
+CONFIG_DM_RESET=y
+CONFIG_BOOTCOUNT_BOOTLIMIT=1
+CONFIG_SYS_LOAD_ADDR=0x1000000
+CONFIG_PCI=y
+CONFIG_ENV_VARS_UBOOT_CONFIG=y
+CONFIG_BOOTSTD_FULL=y
+# CONFIG_BOOTSTD_DEFAULTS is not set
+# CONFIG_BOOTMETH_EFILOADER is not set
+# CONFIG_BOOTMETH_EFI_BOOTMGR is not set
+CONFIG_SUPPORT_RAW_INITRD=y
+CONFIG_BOOTDELAY=1
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_PROMPT="Press <SPACE> or <ENTER> to stop autoboot in %d seconds\n"
+CONFIG_AUTOBOOT_DELAY_STR=" "
+CONFIG_AUTOBOOT_STOP_STR="\r"
+CONFIG_OF_BOARD_SETUP=y
+CONFIG_FDT_SIMPLEFB=y
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="bootflow scan -b"
+CONFIG_USE_PREBOOT=y
+CONFIG_PREBOOT="pci enum"
+CONFIG_SYS_PBSIZE=1049
+# CONFIG_CONSOLE_MUX is not set
+CONFIG_SYS_STDIO_DEREGISTER=y
+# CONFIG_DISPLAY_CPUINFO is not set
+# CONFIG_DISPLAY_BOARDINFO is not set
+CONFIG_BOARD_LATE_INIT=y
+CONFIG_MISC_INIT_R=y
+CONFIG_SYS_PROMPT="U-Boot> "
+# CONFIG_CMD_BOOTEFI is not set
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_MMC=y
+CONFIG_CMD_PART=y
+CONFIG_CMD_PCI=y
+CONFIG_CMD_USB=y
+CONFIG_CMD_DHCP=y
+CONFIG_BOOTP_MAY_FAIL=y
+CONFIG_CMD_NFS=y
+CONFIG_CMD_BOOTCOUNT=y
+# CONFIG_CMD_CLS is not set
+# CONFIG_CMD_EFICONFIG is not set
+CONFIG_CMD_SYSBOOT=y
+CONFIG_CMD_EXT2=y
+CONFIG_CMD_EXT4=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_CMD_FS_UUID=y
+CONFIG_ISO_PARTITION=y
+CONFIG_EFI_PARTITION=y
+# CONFIG_ENV_IS_IN_FAT is not set
+CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
+CONFIG_DM_DMA=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_DM_BOOTCOUNT=y
+CONFIG_DM_BOOTCOUNT_RTC=y
+CONFIG_BCM2835_GPIO=y
+CONFIG_DM_I2C=y
+CONFIG_SYS_I2C_BCM2835=y
+CONFIG_DM_KEYBOARD=y
+CONFIG_MISC=y
+CONFIG_I2C_EEPROM=y
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_SDMA=y
+CONFIG_MMC_SDHCI_BCM2835=y
+CONFIG_PHY_BROADCOM=y
+CONFIG_PHY_ETHERNET_ID=y
+CONFIG_BCMGENET=y
+CONFIG_PCI_BRCMSTB=y
+CONFIG_PINCTRL=y
+# CONFIG_PINCTRL_GENERIC is not set
+CONFIG_DM_RNG=y
+CONFIG_RNG_IPROC200=y
+CONFIG_DM_RTC=y
+CONFIG_RTC_DS1307=y
+# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
+CONFIG_SYSINFO=y
+CONFIG_SYSINFO_SMBIOS=y
+CONFIG_USB=y
+CONFIG_USB_XHCI_HCD=y
+CONFIG_USB_XHCI_PCI=y
+CONFIG_USB_XHCI_BRCM=y
+CONFIG_USB_DWC2=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_HOST_ETHER=y
+CONFIG_VIDEO=y
+# CONFIG_VIDEO_LOGO is not set
+# CONFIG_PANEL is not set
+CONFIG_VIDEO_BCM2835=y
+CONFIG_PHYS_TO_BUS=y
+CONFIG_FS_BTRFS=y
-- 
