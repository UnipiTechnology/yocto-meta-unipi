From d52e4aec4df9776aa31be6d6d62283033c59e615 Mon Sep 17 00:00:00 2001
From: Miroslav Ondra <ondra@faster.cz>
Date: Tue, 10 Sep 2024 21:56:03 +0200
Subject: [PATCH 05/14] Add support for unipi_eprom and altboot button

---
 board/raspberrypi/rpi/Makefile       |   4 +
 board/raspberrypi/rpi/rpi.c          | 137 ++++++++++++++++
 board/raspberrypi/rpi/rpi.env        |   7 +-
 board/raspberrypi/rpi/uniee.h        | 226 +++++++++++++++++++++++++++
 board/raspberrypi/rpi/uniee_values.h |  89 +++++++++++
 board/raspberrypi/rpi/unipi_eprom.c  | 143 +++++++++++++++++
 board/raspberrypi/rpi/unipi_eprom.h  |  19 +++
 7 files changed, 624 insertions(+), 1 deletion(-)
 create mode 100644 board/raspberrypi/rpi/uniee.h
 create mode 100644 board/raspberrypi/rpi/uniee_values.h
 create mode 100644 board/raspberrypi/rpi/unipi_eprom.c
 create mode 100644 board/raspberrypi/rpi/unipi_eprom.h

diff --git a/board/raspberrypi/rpi/Makefile b/board/raspberrypi/rpi/Makefile
index b1186cdf..8bad67ff 100644
--- a/board/raspberrypi/rpi/Makefile
+++ b/board/raspberrypi/rpi/Makefile
@@ -4,3 +4,7 @@
 
 obj-y	:= rpi.o
 obj-y	+= lowlevel_init.o
+
+ifdef CONFIG_I2C_EEPROM
+obj-y += unipi_eprom.o
+endif
diff --git a/board/raspberrypi/rpi/rpi.c b/board/raspberrypi/rpi/rpi.c
index 2851ebc9..18c74cb9 100644
--- a/board/raspberrypi/rpi/rpi.c
+++ b/board/raspberrypi/rpi/rpi.c
@@ -25,6 +25,13 @@
 #include <watchdog.h>
 #include <dm/pinctrl.h>
 
+#include <i2c_eeprom.h>
+#include <linux/delay.h>
+ #define htobe16(x) cpu_to_be16(x)
+#include "uniee.h"
+#include "uniee_values.h"
+#include "unipi_eprom.h"
+
 DECLARE_GLOBAL_DATA_PTR;
 
 /* Assigned in lowlevel_init.S
@@ -568,9 +575,122 @@ void  update_fdt_from_fw(void *fdt, void *fw_fdt)
 	copy_property(fdt, fw_fdt, "ethernet0/mdio@e14/ethernet-phy@1", "reg");
 }
 
+
+#define UNIPI_EEPROM_SIZE UNIEE_MIN_EE_SIZE
+static u8 unipi_eprom[UNIPI_EEPROM_SIZE] __aligned(32);
+static int unipi_eprom_validity = -1;
+uniee_descriptor_area* uniee_descriptor;
+
+#ifdef CONFIG_I2C_EEPROM
+static int get_unipi_eeprom(void)
+{
+	int ret;
+	struct udevice *dev;
+
+	if (unipi_eprom_validity >= 0) {
+		return unipi_eprom_validity;
+	}
+	ret = uclass_first_device_err(UCLASS_I2C_EEPROM, &dev);
+	if (ret)
+		return ret;
+
+	ret = i2c_eeprom_read(dev, 0x0, unipi_eprom, UNIPI_EEPROM_SIZE);
+	if (ret) {
+		return ret;
+	}
+
+    /* check unipi mark */
+	uniee_descriptor = uniee_get_valid_descriptor(unipi_eprom, UNIPI_EEPROM_SIZE);
+	if (uniee_descriptor == NULL) {
+		unipi_eprom_validity = 1;
+		return -1;
+	}
+
+	uniee_fix_legacy_content(unipi_eprom, UNIPI_EEPROM_SIZE, uniee_descriptor);
+	unipi_eprom_validity = 0;
+	return 0;
+
+/*	if ((unipi_eprom[UNIPI_EEPROM_SLOT3_OFFSET] != 0xfa) || (unipi_eprom[UNIPI_EEPROM_SLOT3_OFFSET+1] != 0x55)) {
+		unipi_eprom_validity = 1;
+		return -1;
+	}
+	unipi_eprom_validity = 0;
+	return 0;
+*/
+}
+
+#define NEURON_BUTTON 12
+#define EDGE_BUTTON 25
+
+static int check_button_status(void)
+{
+	ulong button = 0;
+	ulong value = 0;
+	/* if not valid eprom  buttons are unusable */
+	if (get_unipi_eeprom() != 0)
+		return 0;
+
+	//gpio_request(RTS_BUTTON, "rts button");
+	if (unipi_eeprom_get_uint_property(unipi_eprom, uniee_descriptor, UNIEE_FIELD_TYPE_BUTTON, &button) < 0) {
+		button = 0;
+	}
+	switch (button) {
+		//case UNIEE_FIELD_VALUE_BUTTON_IRIS:
+		//	/* check pin GPIO4_27 (UART3_RTS) - button + RTS on IRIS model, RTS only on Patron */
+		//	gpio_direction_input(RTS_BUTTON);
+		//	value = gpio_get_value(RTS_BUTTON);
+		//	break;
+		case UNIEE_FIELD_VALUE_BUTTON_NEURON:
+			gpio_request(NEURON_BUTTON, "neuron button");
+			gpio_direction_input(NEURON_BUTTON);
+			value = gpio_get_value(NEURON_BUTTON);
+			break;
+		case UNIEE_FIELD_VALUE_BUTTON_EDGE:
+			gpio_request(EDGE_BUTTON, "edge button");
+			gpio_direction_input(EDGE_BUTTON);
+			value = gpio_get_value(EDGE_BUTTON);
+			break;
+		default:
+			/* unknown button */
+			return 0;
+	}
+	printf("BUTTON type:%ld value: %ld\n", button, value);
+
+	if ((value == 0) && (button != 0)) {
+		env_set("bootdelay", "-2");
+		return 0;
+	};
+	return value;
+}
+#endif
+
+int board_late_init(void)
+{
+#ifdef CONFIG_I2C_EEPROM
+    if (check_button_status()) {
+        //gpio_direction_output(RTS_BUTTON,1);
+        printf("Switch off BUTTON and press a KEY on console to break autoboot!\n");
+        //gpio_direction_output(RTS_BUTTON,0);
+        /* ToDo: switch console uart into rs485 mode */
+        env_set("bootdelay", "2");
+        env_set("bootcmd", "run boot_altboot;run distro_bootcmd");
+        //tx_active = 0;
+        //rs485_enable = 1;
+    }
+#endif
+#ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
+    env_set("board_name", "UNIPI");
+    env_set("board_rev", "EDGE");
+#endif
+    return 0;
+}
+
+
+#ifdef CONFIG_OF_BOARD_SETUP
 int ft_board_setup(void *blob, struct bd_info *bd)
 {
 	int node;
+    char tmpstr[20];
 
 	update_fdt_from_fw(blob, (void *)fw_dtb_pointer);
 
@@ -586,5 +706,22 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 			   EFI_RESERVED_MEMORY_TYPE);
 #endif
 
+#ifdef CONFIG_I2C_EEPROM
+    if (get_unipi_eeprom() != 0)
+        return 0;
+
+    if (snprintf(tmpstr, sizeof(tmpstr)-1, "%u", unipi_eeprom_get_serial(uniee_descriptor)) >= 0) {
+        tmpstr[sizeof(tmpstr)-1]= '\0';
+        fdt_setprop(blob, 0, "unipi-serial", tmpstr, strlen(tmpstr) + 1);
+    }
+    if (snprintf(tmpstr, sizeof(tmpstr)-1, "%u", unipi_eeprom_get_sku(uniee_descriptor)) >= 0) {
+        tmpstr[sizeof(tmpstr)-1]= '\0';
+        fdt_setprop(blob, 0, "unipi-sku", tmpstr, strlen(tmpstr) + 1);
+    }
+    unipi_eeprom_get_model(uniee_descriptor, tmpstr, sizeof(tmpstr));
+    fdt_setprop(blob, 0, "unipi-model", tmpstr, strlen(tmpstr) + 1);
+#endif
 	return 0;
 }
+#endif
+
