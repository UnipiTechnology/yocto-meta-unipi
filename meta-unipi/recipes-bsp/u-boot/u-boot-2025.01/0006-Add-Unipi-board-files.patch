+static int check_button_status(void)
+{
+	ulong button = 0;
+	ulong value = 0;
+	/* if not valid eprom  buttons are unusable */
+	if (get_unipi_eeprom() != 0)
+		return 0;
+
+	if (unipi_eeprom_get_uint_property(unipi_eprom, uniee_descriptor, UNIEE_FIELD_TYPE_BUTTON, &button) < 0) {
+		button = 0;
+	}
+	switch (button) {
+		//case UNIEE_FIELD_VALUE_BUTTON_IRIS:
+		//	/* check pin GPIO4_27 (UART3_RTS) - button + RTS on IRIS model, RTS only on Patron */
+		//	gpio_direction_input(RTS_BUTTON);
+		//	value = gpio_get_value(RTS_BUTTON);
+		//	break;
+		case UNIEE_FIELD_VALUE_BUTTON_NEURON:
+			gpio_request(NEURON_BUTTON, "neuron button");
+			gpio_direction_input(NEURON_BUTTON);
+			value = gpio_get_value(NEURON_BUTTON);
+			break;
+		case UNIEE_FIELD_VALUE_BUTTON_EDGE:
+			gpio_request(EDGE_BUTTON, "edge button");
+			gpio_direction_input(EDGE_BUTTON);
+			value = gpio_get_value(EDGE_BUTTON);
+			gpio_request(EDGE_RTS, "edge rts");
+			gpio_direction_output(EDGE_RTS, 0);
+			break;
+		default:
+			/* unknown button */
+			return 0;
+	}
+	printf("BUTTON type:%ld value: %ld\n", button, value);
+
+	if ((value == 0) && (button != 0)) {
+		env_set("bootdelay", "-2");
+		return 0;
+	};
+	return value;
+}
+
+static void load_mac_address(u8 index)
+{
+	u8 ethaddr[6];
+	if (get_unipi_eeprom() != 0)
+		return;
+
+	if (unipi_eeprom_get_bytes_property(unipi_eprom, uniee_descriptor,
+	    index?UNIEE_FIELD_TYPE_MAC1:UNIEE_FIELD_TYPE_MAC,
+	    ethaddr, 6) == 6) {
+		if (is_valid_ethaddr(ethaddr)) {
+			eth_env_set_enetaddr_by_index("eth", index,ethaddr);
+		}
+	}
+}
+
+#define MCP794XX_REG_CALIBRATION        0x08
+static void load_rtc_calibration(void)
+{
+	char calibration;
+	struct udevice *dev;
+	int ret;
+
+	if (get_unipi_eeprom() != 0)
+		return;
+	if (unipi_eeprom_get_bytes_property(unipi_eprom, uniee_descriptor, UNIEE_FIELD_TYPE_RTC, &calibration, 1) != 1)
+		return;
+	ret = uclass_get_device_by_name(UCLASS_RTC, "mcp7940x@6f", &dev);
+	if (ret != 0) {
+		ret = uclass_get_device_by_name(UCLASS_RTC, "rtc@6f", &dev);
+		if (ret != 0)
+			return;
+	}
+	rtc_write8(dev, MCP794XX_REG_CALIBRATION, calibration);
+}
+#endif
+
+int board_late_init(void)
+{
+#ifdef CONFIG_I2C_EEPROM
+    if (get_unipi_eeprom() == 0) {
+        if (check_button_status()) {
+            tx_active = 0;
+            rs485_enable = 1;
+            printf("Switch off BUTTON and press a KEY on console to break autoboot!\n");
+            env_set("bootdelay", "2");
+            env_set("bootcmd", "run boot_altboot;bootflow scan -lb");
+        }
+        load_mac_address(0);
+        load_mac_address(1);
+        load_rtc_calibration();
+    }
+#endif
+#ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
+    env_set("board_name", "UNIPI");
+    env_set("board_rev", "EDGE");
+#endif
+    set_usbethaddr();
+    return 0;
+}
