From ad38aba2c2d5ab44640038b9f85d941b93dd513b Mon Sep 17 00:00:00 2001
From: Miroslav Ondra <ondra@faster.cz>
Date: Fri, 20 Sep 2024 16:59:41 +0200
Subject: [PATCH 5/6] Add driver for BCM2835 DMA mux

---
 drivers/dma/Kconfig          |   7 ++
 drivers/dma/Makefile         |   1 +
 drivers/dma/bcm2835-dmamux.c | 202 +++++++++++++++++++++++++++++++++++
 3 files changed, 210 insertions(+)
 create mode 100644 drivers/dma/bcm2835-dmamux.c

diff --git a/drivers/dma/Kconfig b/drivers/dma/Kconfig
index 60b10aed1..2888b707d 100644
--- a/drivers/dma/Kconfig
+++ b/drivers/dma/Kconfig
@@ -140,6 +140,13 @@ config DMA_BCM2835
 	select DMA_ENGINE
 	select DMA_VIRTUAL_CHANNELS
 
+config DMAMUX_BCM2835
+	tristate "Renesas RZ/N1 DMAMUX driver"
+	depends on ARCH_BCM2835
+	help
+	  Support Broadcom BCM2835 DMA_CNTRL_MUX bits for alternate DREQ
+	  mapping through PACTL_CS register
+
 config DMA_JZ4780
 	tristate "JZ4780 DMA support"
 	depends on MIPS || COMPILE_TEST
diff --git a/drivers/dma/Makefile b/drivers/dma/Makefile
index b4a8e3585..367154db1 100644
--- a/drivers/dma/Makefile
+++ b/drivers/dma/Makefile
@@ -24,6 +24,7 @@ obj-$(CONFIG_AXI_DMAC) += dma-axi-dmac.o
 obj-$(CONFIG_BCM_SBA_RAID) += bcm-sba-raid.o
 obj-$(CONFIG_DMA_BCM2708) += bcm2708-dmaengine.o
 obj-$(CONFIG_DMA_BCM2835) += bcm2835-dma.o
+obj-$(CONFIG_DMAMUX_BCM2835) += bcm2835-dmamux.o
 obj-$(CONFIG_DMA_JZ4780) += dma-jz4780.o
 obj-$(CONFIG_DMA_SA11X0) += sa11x0-dma.o
 obj-$(CONFIG_DMA_SUN4I) += sun4i-dma.o
diff --git a/drivers/dma/bcm2835-dmamux.c b/drivers/dma/bcm2835-dmamux.c
new file mode 100644
index 000000000..c6b5ace3f
--- /dev/null
+++ b/drivers/dma/bcm2835-dmamux.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2024 Miroslav Ondra
+ * Author: Miroslav Ondra <ondra@unipi.technology>
+ * Based on rzn1-dmamux.c driver written by Miquel Raynal <miquel.raynal@bootlin.com>
+ */
+#include <linux/bitops.h>
+#include <linux/of.h>
+#include <linux/of_dma.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+
+#define BCM2835_DMAMUX_NCELLS 2
+#define BCM2835_DMAMUX_MAX_DREQ 32
+#define BCM2835_DMAMUX_CNTL_BITS 3
+
+struct bcm2835_dmamux_data {
+	struct dma_router dmarouter;
+	void __iomem *base;
+	spinlock_t lock; /* Protects register access */
+	struct device_node *dmac_node;
+	DECLARE_BITMAP(used_dreq, BCM2835_DMAMUX_MAX_DREQ);
+	int level[BCM2835_DMAMUX_CNTL_BITS];
+	int value[BCM2835_DMAMUX_CNTL_BITS];
+};
+
+struct bcm2835_dmamux_map {
+	unsigned int req_idx;
+	unsigned int cntl_bit;
+};
+
+
+static void bcm2835_dmamux_free(struct device *dev, void *route_data)
+{
+	struct bcm2835_dmamux_data *dmamux = dev_get_drvdata(dev);
+	struct bcm2835_dmamux_map *map = route_data;
+	unsigned long flags;
+
+	dev_dbg(dev, "Unmapping DMAMUX request %u\n", map->req_idx);
+	if (map->cntl_bit >= BCM2835_DMAMUX_CNTL_BITS) {
+		clear_bit(map->req_idx, dmamux->used_dreq);
+		spin_lock_irqsave(&dmamux->lock, flags);
+		if (dmamux->level[map->cntl_bit] > 0)
+			dmamux->level[map->cntl_bit]--;
+		spin_unlock_irqrestore(&dmamux->lock, flags);
+	}
+	kfree(map);
+}
+
+static void *bcm2835_dmamux_route_allocate(struct of_phandle_args *dma_spec,
+					struct of_dma *ofdma)
+{
+	struct platform_device *pdev = of_find_device_by_node(ofdma->of_node);
+	struct bcm2835_dmamux_data *dmamux = platform_get_drvdata(pdev);
+	struct bcm2835_dmamux_map *map;
+	unsigned int chan, val;
+	u32 mask = 0;
+	unsigned long flags;
+	int ret;
+
+	if (dma_spec->args_count != BCM2835_DMAMUX_NCELLS)
+		return ERR_PTR(-EINVAL);
+
+	map = kzalloc(sizeof(*map), GFP_KERNEL);
+	if (!map)
+		return ERR_PTR(-ENOMEM);
+
+	chan = dma_spec->args[0];
+	map->req_idx = chan;
+	val = dma_spec->args[1];
+	dma_spec->args_count--;
+	dma_spec->np = dmamux->dmac_node;
+
+	if (chan >= BCM2835_DMAMUX_MAX_DREQ) {
+		dev_err(&pdev->dev, "Invalid DMA request line: %u\n", chan);
+		ret = -EINVAL;
+		goto free_map;
+	}
+
+	dev_dbg(&pdev->dev, "DMA request line: %u %u\n", chan, val);
+	if (chan == 1) {
+		mask = (1<<23);
+		map->cntl_bit=2;
+	} else if ((chan == 19) || (chan == 20)) {
+		mask = (1<<24);
+		map->cntl_bit=0;
+	} else if ((chan == 21) || (chan == 22)) {
+		mask = (1<<25);
+		map->cntl_bit=1;
+	} else {
+		map->cntl_bit=BCM2835_DMAMUX_CNTL_BITS;
+		return map;
+	}
+
+/*	dev_dbg(&pdev->dev, "Mapping DMAMUX request %u to DMAC%u request %u\n",
+		map->req_idx, dmac_idx, chan);
+*/
+	if (test_and_set_bit(map->req_idx, dmamux->used_dreq)) {
+		ret = -EBUSY;
+		goto free_map;
+	}
+
+	spin_lock_irqsave(&dmamux->lock, flags);
+	if (dmamux->level[map->cntl_bit] == 0) {
+		dmamux->value[map->cntl_bit] = val;
+	} else if (dmamux->value[map->cntl_bit] != val) {
+		goto clear_bitmap;
+	}
+	dmamux->level[map->cntl_bit]++;
+	if (val) {
+		writel(readl(dmamux->base) | mask, dmamux->base);
+	} else {
+		writel(readl(dmamux->base) & (~mask), dmamux->base);
+	}
+	spin_unlock_irqrestore(&dmamux->lock, flags);
+
+	return map;
+
+clear_bitmap:
+	spin_unlock_irqrestore(&dmamux->lock, flags);
+	clear_bit(map->req_idx, dmamux->used_dreq);
+free_map:
+	kfree(map);
+
+	return ERR_PTR(ret);
+}
+/*
+#ifdef CONFIG_OF
+static const struct of_device_id rzn1_dmac_match[] = {
+	{ .compatible = "brcm,rzn1-dma" },
+	{}
+};
+#endif
+*/
+static int bcm2835_dmamux_probe(struct platform_device *pdev)
+{
+	struct device_node *mux_node = pdev->dev.of_node;
+/*	const struct of_device_id *match;
+*/
+	struct device_node *dmac_node;
+	struct bcm2835_dmamux_data *dmamux;
+	void __iomem *base;
+
+	dmamux = devm_kzalloc(&pdev->dev, sizeof(*dmamux), GFP_KERNEL);
+	if (!dmamux)
+		return -ENOMEM;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	dmamux->base = base;
+
+	spin_lock_init(&dmamux->lock);
+
+	dmac_node = of_parse_phandle(mux_node, "dma-masters", 0);
+	if (!dmac_node)
+		return dev_err_probe(&pdev->dev, -ENODEV, "Can't get DMA master node\n");
+	dmamux->dmac_node = dmac_node;
+/*
+	match = of_match_node(rzn1_dmac_match, dmac_node);
+	of_node_put(dmac_node);
+	if (!match)
+		return dev_err_probe(&pdev->dev, -EINVAL, "DMA master is not supported\n");
+*/
+	dmamux->dmarouter.dev = &pdev->dev;
+	dmamux->dmarouter.route_free = bcm2835_dmamux_free;
+
+	platform_set_drvdata(pdev, dmamux);
+
+	return of_dma_router_register(mux_node, bcm2835_dmamux_route_allocate,
+				      &dmamux->dmarouter);
+}
+
+static int bcm2835_dmamux_remove(struct platform_device *pdev)
+{
+	struct bcm2835_dmamux_data *dmamux = platform_get_drvdata(pdev);
+	of_node_put(dmamux->dmac_node);
+	return 0;
+}
+
+
+static const struct of_device_id bcm2835_dmamux_match[] = {
+	{ .compatible = "brcm,bcm2835-dmamux" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, bcm2835_dmamux_match);
+
+static struct platform_driver bcm2835_dmamux_driver = {
+	.driver = {
+		.name = "brcm,bcm2835-dmamux",
+		.of_match_table = bcm2835_dmamux_match,
+	},
+	.probe	= bcm2835_dmamux_probe,
+	.remove	= bcm2835_dmamux_remove,
+};
+module_platform_driver(bcm2835_dmamux_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Miroslav Ondra <ondra@unipi.technology");
+MODULE_DESCRIPTION("Broadcom BCM2835 DMAMUX driver");
-- 
2.39.2

