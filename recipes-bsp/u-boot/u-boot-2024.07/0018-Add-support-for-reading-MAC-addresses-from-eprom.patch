Date: Wed, 2 Oct 2024 21:47:53 +0200
Subject: [PATCH] Add support for reading MAC addresses from eprom

---
 board/raspberrypi/rpi/rpi.c          | 23 ++++++-
 board/raspberrypi/rpi/uniee_values.h | 95 ++++++++++++++++++++++++----
 board/raspberrypi/rpi/unipi_eprom.c  | 15 +++++
 board/raspberrypi/rpi/unipi_eprom.h  |  1 +
 4 files changed, 121 insertions(+), 13 deletions(-)

diff --git a/board/raspberrypi/rpi/rpi.c b/board/raspberrypi/rpi/rpi.c
index dd102c9c..8a2a731e 100644
--- a/board/raspberrypi/rpi/rpi.c
+++ b/board/raspberrypi/rpi/rpi.c
@@ -26,6 +26,7 @@
 #include <watchdog.h>
 #include <dm/pinctrl.h>
 #include <usb.h>
+#include <net.h>
 
 #include <i2c_eeprom.h>
 #include <linux/delay.h>
@@ -363,6 +364,9 @@ static void set_usbethaddr(void)
 	if (!model->has_onboard_eth)
 		return;
 
+	if (env_get("ethaddr"))
+		return;
+
 	if (env_get("usbethaddr"))
 		return;
 
@@ -428,7 +432,6 @@ int misc_init_r(void)
 {
 	set_fdt_addr();
 	set_fdtfile();
-	set_usbethaddr();
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
 	set_board_info();
 #endif
@@ -725,6 +728,21 @@ static int check_button_status(void)
 	};
 	return value;
 }
+
+static void load_mac_address(u8 index)
+{
+	u8 ethaddr[6];
+	if (get_unipi_eeprom() != 0)
+		return;
+
+	if (unipi_eeprom_get_bytes_property(unipi_eprom, uniee_descriptor,
+	    index?UNIEE_FIELD_TYPE_MAC1:UNIEE_FIELD_TYPE_MAC,
+	    ethaddr, 6) == 6) {
+		if (is_valid_ethaddr(ethaddr)) {
+			eth_env_set_enetaddr_by_index("eth", index,ethaddr);
+		}
+	}
+}
 #endif
 
 int board_late_init(void)
@@ -737,11 +755,14 @@ int board_late_init(void)
         env_set("bootdelay", "2");
         env_set("bootcmd", "run boot_altboot;bootflow scan -lb");
     }
+    load_mac_address(0);
+    load_mac_address(1);
 #endif
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
     env_set("board_name", "UNIPI");
     env_set("board_rev", "EDGE");
 #endif
+    set_usbethaddr();
     return 0;
 }
 
